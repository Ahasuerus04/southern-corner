{
  "name": "sidewave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib setup tests",
    "auth:enable": "bun --env-file=.env.local --env-file=.env setup/enable.ts",
    "db:migrate": "bun --env-file=.env.local --env-file=.env run drizzle-kit migrate",
    "admin:create": "bun --env-file=.env.local --env-file=.env setup/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.16.0",
    "music-metadata": "^12.7.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
