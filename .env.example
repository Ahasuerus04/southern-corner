# Copy to .env.local on your computer. No credentials are bundled.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional administrator password resets
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=
# Enable only behind a proxy that overwrites X-Real-IP
TRUST_PROXY=0
# One-time administrator bootstrap only; remove both afterward
ADMIN_EMAIL=
ADMIN_PASSWORD=
