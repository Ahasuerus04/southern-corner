# Copy this file to .env.local on your computer. No credentials are bundled.
# Next.js loads .env.local automatically. The Bun setup scripts read
# .env.local first, then .env, so either location works for local tooling.

# Neon PostgreSQL (pooled connection string, sslmode=require)
DATABASE_URL=

# Better Auth session signing secret (at least 32 random characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Object Storage (S3-compatible API). Server-only: never prefix these
# with NEXT_PUBLIC_. On Vercel, add every value below to the project's
# Production environment and redeploy. Environment variable changes do not
# affect existing deployments.
#
# Vercel sets AWS_REGION to the function's own region even when you do not
# configure it. Set AWS_REGION explicitly (Neon uses "auto") or use S3_REGION.
# The S3_* aliases (S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY) are also supported and take precedence over the AWS_*
# names, so serverless platform credentials cannot shadow your bucket keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
NEON_STORAGE_BUCKET=
# Set to "false" only when the provider requires virtual-hosted-style buckets.
S3_FORCE_PATH_STYLE=true
# Comma-separated browser origins allowed to upload directly to the bucket,
# for example: https://your-app.vercel.app. Run `bun run storage:cors` after
# changing this. Localhost is always included.
APP_ORIGINS=

# Upload limits in MiB (optional; defaults are 32 and 5)
MAX_AUDIO_SIZE_MB=32
MAX_ARTWORK_SIZE_MB=5

# Optional administrator password resets through Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# Enable only behind a reverse proxy that overwrites X-Real-IP
TRUST_PROXY=0

# One-time administrator bootstrap. Remove all three after running
# `bun run admin:create`.
ADMIN_EMAIL=
ADMIN_USERNAME=Haswell
ADMIN_PASSWORD=Ahaslip
